# Copia este archivo a .env (cp .env.example .env) y cambia las contraseñas.
# .env NO se versiona. Evita los caracteres @ : / ? # % en las contraseñas (van dentro de URLs).

# ---------- Airflow ----------
# En Linux usa tu uid real (id -u) para que los archivos de logs/ y data/work no queden de root.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=12345
# Regenera ambas claves para cualquier uso fuera de una prueba local:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=PoXe7RZxifEArG8uSAg5UcmiCyFQtc8rBb89VRwJIxo=
AIRFLOW_WEBSERVER_SECRET_KEY=e53222072fe976ec74fbf4df291eaed3899ce5998a0d7ffc

# Puerto del host para la UI de Airflow (el enunciado usa 8080; cámbialo solo si está ocupado)
AIRFLOW_WEBSERVER_PORT=8080

# ---------- PostgreSQL de metadatos de Airflow (no es el repositorio analítico) ----------
AIRFLOW_DB_USER=airflow_meta
AIRFLOW_DB_PASSWORD=12345
AIRFLOW_DB_NAME=airflow_metadata

# ---------- PostgreSQL del repositorio analítico (destino del pipeline) ----------
WAREHOUSE_DB_USER=dw_user
WAREHOUSE_DB_PASSWORD=12345
WAREHOUSE_DB_NAME=datamart_dw
# Puerto del host para conectarte con psql/DBeaver (dentro de Docker siempre es 5432)
WAREHOUSE_HOST_PORT=5433

# ---------- Datos y parámetros operativos (se vuelven Airflow Variables al iniciar) ----------
# Carpeta del host con data.csv y online_retail_II.csv. Para una prueba rápida con los seeds
# incluidos en el repo usa: RAW_DATA_DIR=./data/seeds
RAW_DATA_DIR=./data/seeds
DATAMART_SALES_FILE=data.csv
# Historial (online_retail_II.csv, incluido en data/seeds). Déjalo vacío para omitir esta fuente sin fallar
DATAMART_HISTORY_FILE=online_retail_II.csv
# Zona horaria en la que vienen las fechas de los CSV (se convierten a UTC al cargar)
DATAMART_SOURCE_TIMEZONE=Europe/London
# Si una fuente supera esta fracción de filas rechazadas, el pipeline falla antes de cargar
DATAMART_MAX_REJECT_RATIO=0.05
# API interna de productos (servicio products-api del compose). Déjalo vacío para usar solo las reglas de categoría
DATAMART_PRODUCTS_API_URL=http://products-api:8000
# Puerto del host para la API (docs interactivas en http://localhost:8000/docs)
PRODUCTS_API_PORT=8000
